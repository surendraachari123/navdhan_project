# --- NavDhan AI: add these to your existing .env ---------------------------
# Free key from https://console.groq.com  (required for /ai/ask, /ai/chat and the Insights narrative)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Qdrant (semantic glossary retrieval, same approach as NavDhan AI) ------
# Local Docker:   docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
# Qdrant Cloud (use this when the API runs on Render - free 1 GB cluster at cloud.qdrant.io):
# QDRANT_URL=https://xxxxxxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_key
# No Qdrant server at all? index lives inside the API process and is rebuilt on restart:
# QDRANT_URL=:memory:
AI_USE_QDRANT=true
QDRANT_COLLECTION=navdhan_fastapi_schema
AI_RETRIEVAL_LIMIT=6

# --- Optional ---------------------------------------------------------------
# Tables the AI may read (comma separated)
AI_ALLOWED_TABLES=investor_table,mfund_transactions
# Personal-data columns hidden from everyone except admins
AI_SENSITIVE_COLUMNS=pan,mobile,email
AI_MAX_ROWS=200
AI_QUERY_TIMEOUT_MS=15000
AI_INSIGHTS_CACHE_MINUTES=10

# --- Market Research ---------------------------------------------------------
# The implemented provider adapter uses Alpha Vantage's daily prices/news API.
# Do not enable this for manager use with a free/personal key. Its free terms
# exclude money-manager affiliations. Obtain provider terms covering this use.
MARKET_DATA_API_KEY=your_provider_key_here
MARKET_DATA_LICENSE_CONFIRMED=false
# Provider symbols are configurable; Alpha Vantage uses exchange suffixes,
# for example RELIANCE.BSE. Free tier is limited to 25 requests per day.
MARKET_WATCHLIST=RELIANCE.BSE,TCS.BSE,INFY.BSE,SUZLON.BSE,IDEA.BSE,JPL.BSE,HDFCBANK.BSE
MARKET_QDRANT_COLLECTION=navdhan_market_analysis
